import re
from collections import deque

def normalize_quotes_advanced(text: str) -> str:
    """
    Финальная версия скрипта для автоматической корректуры.
    """
    
    # 1. База данных названий (Белый список)
    # Все названия в нижнем регистре для регистронезависимого поиска
    safe_list = {
        'академический проект', 'кнорус', 'юрайт', 'дашков и к°', 'рггу', 'скфу', 
        'психологические технологии', 'введение в профессию', 'социальная работа',
        'основная', 'дополнительная' # Для списков литературы
    }

    # 2. Удаление кавычек у иностранных слов (латиница + аббревиатуры)
    # Работает только если внутри нет кириллицы
    def remove_foreign(match):
        return match.group(1)
    
    text = re.sub(r'«\s*([A-Za-z0-9\s\-\.\,\:\;$$\/]+)\s*»', remove_foreign, text)

    # 3. Исправление вложенности (основной цикл со стеком)
    # Мы идем по символам и считаем уровень вложенности
    result = []
    stack = []
    i = 0
    
    while i < len(text):
        if text[i:i+2] == '«':
            # Если это первый уровень — открываем ёлочки
            if not stack:
                result.append('«')
            # Если это второй и далее уровень — открываем лапки
            else:
                result.append('„')
            stack.append('«')
            i += 2
            continue
            
        if text[i:i+2] == '»':
            if stack:
                stack.pop()
            # Закрываем тем же типом, что и открыли
            if not stack:
                result.append('»')
            else:
                result.append('“')
            i += 2
            continue
            
        result.append(text[i])
        i += 1
        
    text = ''.join(result)

    # 4. Добавление кавычек для белого списка (если их пропустили при OCR)
    # Ищем слова из списка, которые стоят сами по себе
    # Сортируем по длине, чтобы "дашков и к°" нашелся раньше, чем "дашков"
    for item in sorted(safe_list, key=len, reverse=True):
        # \b — граница слова. Это защитит от замены слова "работа" внутри "социальная работа"
        pattern = rf'(\b)({re.escape(item)})(\b)'
        text = re.sub(pattern, rf'\1«\2»\3', text, flags=re.IGNORECASE)

    # 5. Финальная чистка знаков препинания
    # Убираем пробелы перед закрывающими кавычками любой формы
    text = re.sub(r'\s+([»“»])', r'\1', text)
    
    # Переносим ! ? ... перед кавычку
    text = re.sub(r'\s*([…!?])([»“»])', r'\1\2', text)
    
    # Ставим точку после кавычки (если это конец предложения)
    text = re.sub(r'([»“»])\s*\.', r'\1.', text)
    
    return text

# --- Демонстрация работы ---

test_data = [
    '«API» — это «Application Programming Interface».',
    'Учебник от КНОРУС и Юрайт.', 
    'См. «Издательство «КНОРУС»»', 
    'Он спросил: «Кто там?» .',
    'литература: основная, дополнительная'
]

print("Итоговая демонстрация:\n" + "-"*30)
for line in test_data:
    print(f"-> {normalize_quotes_advanced(line)}")
